# profiles/inplace-qwen2.5-0.5b-npu1.env
# 容器内直跑 profile — Qwen2.5-0.5B · 1 NPU
# 用法：
#   VLLM_HUST_API_KEY=testkey123 \
#     bash scripts/manage-container.sh start --profile profiles/inplace-qwen2.5-0.5b-npu1.env
#
# 重要约定：此文件不写 API key。Secret 走 VLLM_HUST_API_KEY 环境变量。
# 想换端口 / 换 NPU / 换模型，覆盖同名 VLLM_ENGINE_* 即可。

# ===== 路径 =====
VLLM_ENGINE_MODEL_PATH=/root/.cache/huggingface/hub/Qwen2.5-0.5B-Instruct
VLLM_ENGINE_SERVED_MODEL_NAME=qwen2.5-0.5b

# ===== 网络 =====
VLLM_ENGINE_HOST=0.0.0.0
VLLM_ENGINE_PORT=8001

# ===== 拓扑 =====
VLLM_ENGINE_TP_SIZE=1
VLLM_ENGINE_NPU_DEVICES=0
ASCEND_RT_VISIBLE_DEVICES=0
ASCEND_VISIBLE_DEVICES=0

# ===== 调度 =====
VLLM_ENGINE_MAX_MODEL_LEN=4096
VLLM_ENGINE_MAX_NUM_BATCHED_TOKENS=4096
VLLM_ENGINE_MAX_NUM_SEQS=64
VLLM_ENGINE_GPU_MEM_UTIL=0.85
VLLM_ENGINE_DTYPE=bfloat16
VLLM_ENGINE_LOAD_FORMAT=auto
VLLM_ENGINE_QUANTIZATION=

# ===== 优化开关 =====
VLLM_ENGINE_ENABLE_PREFIX_CACHING=1
VLLM_ENGINE_ENABLE_CHUNKED_PREFILL=1
VLLM_ENGINE_ENFORCE_EAGER=0
VLLM_ENGINE_COMPILATION_CONFIG=

# ===== Ascend / torch =====
VLLM_PLUGINS=ascend
COMPILE_CUSTOM_KERNELS=1
TORCH_DEVICE_BACKEND_AUTOLOAD=1
PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ===== Manager 行为 =====
VLLM_MANAGER_AUTOSTART=1
# VLLM_MANAGER_LOG_DIR=/tmp/vllm-hust-manager   # 留空走脚本默认（/tmp/vllm-hust-manager）
VLLM_MANAGER_CONDA_ENV=vllm-hust-dev
