# 复制本文件为 .env 并填入真实值：cp .env.template .env

# GitHub Personal Access Token (required for cloning private sagellm-* repos)
# Required scopes (classic token): repo, read:org
GITHUB_TOKEN=

# Optional: Hugging Face token for model download
HF_ENDPOINT=
HF_TOKEN=

# Optional: PyPI token for private publishing workflows
PYPI_TOKEN=

# Web search token (used by EvoScientist / workstation search tools)
TAVILY_TOKEN=

# Cloudflare integration
# 1) Put a parent token with "Create Additional Tokens" capability in CLOUDFLARE_BOOTSTRAP_TOKEN.
#    Or use Global API Key mode: set CLOUDFLARE_EMAIL + CLOUDFLARE_GLOBAL_API_KEY.
# 2) Run: python scripts/create_cloudflare_api_token.py --zone-id <ZONE_ID>
# 3) The script writes CLOUDFLARE_API_TOKEN back to this .env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_GLOBAL_API_KEY=
CLOUDFLARE_BOOTSTRAP_TOKEN=
CLOUDFLARE_API_TOKEN=

# Large-model API shared credentials
# VLLM_HUST_API_BASE_URL: public-facing OpenAI-compatible endpoint
# VLLM_HUST_API_KEY: shared secret for auth-proxy / external clients
VLLM_HUST_API_BASE_URL=
VLLM_HUST_API_KEY=

# --- vLLM-HUST one-command engine management (used by ./manage.sh) ---
# The engine is launched from the host with docker exec; do not start it by
# hand inside the container.  If the container is missing/stopped, manage.sh can
# create/start it through scripts/ascend-official-container.sh, which pulls the
# official Docker image when needed.
VLLM_ENGINE_CONTAINER_NAME=vllm-ascend-dev
# Deprecated compatibility alias: VLLM_ENGINE_CONTAINER
VLLM_ENGINE_AUTO_CREATE_CONTAINER=true
# VLLM_ENGINE_RECREATE_CONTAINER=false
# Pin the official 0.23 runtime carrier. It contains CANN Toolkit/ops/HCCL,
# Torch-NPU, vLLM, and vLLM-Ascend; the host supplies only devices and driver
# interfaces.
VLLM_ENGINE_IMAGE=quay.io/ascend/vllm-ascend:v0.23.0-openeuler
# Optional: select a non-secret engine profile.  Profiles contain model,
# topology, plugin, and smoke-test settings.  Keep secrets in local .env.
# VLLM_ENGINE_ENV_FILE=profiles/smoke-qwen2.5-7b-npu1.env
# Optional launch knobs.  Set these in a profile or local .env; the launcher
# intentionally has no hard-coded model default.
# VLLM_ENGINE_MODEL_PATH=/data/shared_models/modelscope_cache/Qwen/Qwen3-32B
# VLLM_ENGINE_SERVED_MODEL_NAME=qwen3-32b
# VLLM_ENGINE_HOST=0.0.0.0
# VLLM_ENGINE_PORT=8000
# VLLM_ENGINE_TP_SIZE=4
# VLLM_ENGINE_NPU_DEVICES=0,1,2,3
# VLLM_ENGINE_MAX_MODEL_LEN=32768
# VLLM_ENGINE_MAX_NUM_SEQS=16
# VLLM_ENGINE_GPU_MEM_UTIL=0.85
# Prefix caching is enabled by default. Production profiles should also set the
# require flag so a stale machine-local override fails before container launch.
# VLLM_ENGINE_ENABLE_PREFIX_CACHING=1
# VLLM_ENGINE_REQUIRE_PREFIX_CACHING=1
# Optional KV-cache storage type. Some model backends require an explicit
# layout, for example DeepSeek-V4 fp8_ds_mla requires `fp8`.
# VLLM_ENGINE_KV_CACHE_DTYPE=fp8
# Optional deterministic per-device KV budget for backends whose lazy graph
# allocations make automatic free-memory snapshots unreliable.
# VLLM_ENGINE_KV_CACHE_MEMORY_BYTES=
# Point HOME at a container path whose .cache directory is bind-mounted when
# graph compilation artifacts should survive managed container recreation.
# VLLM_ENGINE_CONTAINER_HOME=/root
# VLLM_ASCEND_ENABLE_MLAPO=1
# VLLM_ASCEND_KV_CACHE_FREE_MEMORY_FRACTION=0.8
# Current vLLM-Ascend deprecates the legacy FlashComm/FUSED_MC2 environment
# switches. Only old, explicitly verified plugin profiles may opt back in.
# VLLM_ENGINE_ENABLE_LEGACY_ASCEND_ENV=0
# VLLM_ASCEND_ENABLE_FLASHCOMM1=
# VLLM_ASCEND_ENABLE_FUSED_MC2=
# Optional: force the Python interpreter used inside the container for vLLM and
# runtime probes.  Useful when binary extensions are tied to a specific CPython.
# VLLM_ENGINE_PYTHON=/usr/local/python3.12.13/bin/python
# Leave VLLM_ENGINE_CONDA_ENV unset to use the image-native Python runtime.
# Optional: disable vllm-ascend custom kernels when a Python/CANN stack lacks a
# specific custom op, e.g. Python 3.12 smoke on 910B without AddRmsNormBias.
# COMPILE_CUSTOM_KERNELS=0
# VLLM_ENGINE_COMPILATION_CONFIG={"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[1,2,4,8,16],"max_cudagraph_capture_size":16}
# VLLM_ENGINE_CONTAINER_LOG_FILE=/tmp/vllm-hust-engine.log
# TORCH_DEVICE_BACKEND_AUTOLOAD=1
# Optional generic plugin/runtime knobs.  Put repo-specific paths and plugin
# names in the caller's environment or local .env, not in dev-hub scripts.
# Preferred: select a sibling repository manifest through manage.sh.
# VLLM_OPTIMIZATION_PROFILE=bidkv
# VLLM_PLUGINS=ascend,ascend_kv_connector,ascend_model,ascend_model_loader,ascend_service_profiling
# VLLM_ENGINE_BASE_PYTHONPATH=/workspace/vllm-hust:/workspace/vllm-ascend-hust
# VLLM_OPTIMIZATION_REPO_CONTAINER=/workspace/my-optimization-repo
# VLLM_OPTIMIZATION_SRC_SUBDIR=src
# VLLM_OPTIMIZATION_PLUGIN=my_plugin
# VLLM_OPTIMIZATION_ENTRYPOINT_GROUP=vllm.general_plugins
# VLLM_OPTIMIZATION_AUTO_INSTALL=true
# Auto-install uses a launch-unique container-local target and never writes to
# VLLM_ENGINE_PYTHON's immutable prefix. false refuses before creating it.
# VLLM_OPTIMIZATION_ENV_PREFIX=MY_PLUGIN_
# VLLM_ENGINE_PYTHONPATH=/workspace/my-optimization-repo/src:/workspace/my-optimization-repo:/workspace/vllm-hust:/workspace/vllm-ascend-hust
# Default 0 filters inherited PYTHONPATH entries that contain another vLLM or
# vllm-ascend source tree while preserving CANN runtime-only paths.
# VLLM_ENGINE_INHERIT_PYTHONPATH=0
# Fail-closed contract for modules intentionally loaded from an image wheel
# instead of a mounted source tree. Distribution versions must match exactly.
# VLLM_ENGINE_INSTALLED_MODULES_JSON={}
# VLLM_ENGINE_EXTRA_ENV_KEYS=MY_PLUGIN_ENABLE,MY_PLUGIN_MODE
# VLLM_ENGINE_EXTRA_ENV_PREFIXES=MY_PLUGIN_

# --- Container SSH (used by scripts/ascend-container-runtime.sh) ---
# Required: OS username inside the container
CONTAINER_SSH_USER=
# Optional (defaults shown):
# CONTAINER_SSH_PORT=2237
# CONTAINER_SSH_AUTHORIZED_KEYS=/workspace/.ssh/authorized_keys
